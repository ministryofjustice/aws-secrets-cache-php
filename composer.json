{
  "name": "ministryofjustice/aws-secrets-cache-php",
  "description": "AWS Secrets Manager caching for PHP (PSR-16, APCu cache storage, ENV-prefixed secrets).",
  "prefer-stable": true,
  "minimum-stability": "dev",
  "keywords": ["aws", "secrets manager", "cache"],
  "require": {
    "php": "^8.2",
    "aws/aws-sdk-php": "^3.198",
    "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "MoJ\\AwsSecretsCache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MoJ\\AwsSecretsCache\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "scripts": {
    "test": "phpunit --log-junit=./test-results/phpunit.xml",
    "phpstan": "phpstan analyse --memory-limit=1G --error-format=github",
    "phpcs": "phpcs --report=xml -s ."
  },
  "config": {
    "sort-packages": true,
    "platform": {
        "php": "8.2"
    }
  }
}
